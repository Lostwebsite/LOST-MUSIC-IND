rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function admin() { return request.auth != null && request.auth.uid == 'ADMIN_UID'; }

    // public: only the username is visible to others
    match /users/{u} {
      allow read: if signed();
      allow create, update: if request.auth.uid == u
        && request.resource.data.keys().hasOnly(['username','usernameLower','createdAt']);
    }
    match /usernames/{n} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.uid == request.auth.uid;
    }
    // private: name, email, phone are readable only by the owner and by you (admin)
    match /private/{u} {
      allow read: if signed() && (request.auth.uid == u || admin());
      allow write: if signed() && request.auth.uid == u;
    }
    match /chats/{c} {
      allow read, update: if signed() && request.auth.uid in resource.data.members;
      allow create: if signed() && request.auth.uid in request.resource.data.members;
      match /messages/{m} {
        allow read: if signed() && request.auth.uid in get(/databases/$(database)/documents/chats/$(c)).data.members;
        allow create: if signed() && request.resource.data.from == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(c)).data.members;
      }
    }
    match /reports/{r} {
      allow create: if signed();
      allow read: if admin();
    }
  }
}
